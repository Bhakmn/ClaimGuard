# ── ClaimGuard — single environment file ──────────────────────────────────────
#
# Copy this file to .env and fill in the values you have.
# Everything is optional: the app runs on mock/demo data when keys are absent.
#
#   cp .env.example .env
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time.
# All other variables are server-only (backend process).

# ── Service mode ──────────────────────────────────────────────────────────────
# Set to "true" to use real backend services (scan, account, publish).
# The frontend will also auto-detect and fall back to demo mode when the
# backend is unreachable, even if this is "true".
NEXT_PUBLIC_USE_REAL_SERVICES=false

# ── API base URL (browser) ────────────────────────────────────────────────────
# Leave EMPTY for same-origin (required for TikTok OAuth and cookie auth).
# The Next.js dev server proxies /api/* and /auth/* to BACKEND_ORIGIN below.
NEXT_PUBLIC_API_BASE_URL=

# ── Backend proxy (Next.js dev server only) ───────────────────────────────────
# Address of the backend for the Next.js dev-server proxy rule in next.config.ts.
# Not used in production — the reverse proxy handles routing there.
BACKEND_ORIGIN=http://localhost:4000

# ── YouTube (browser-side; optional) ─────────────────────────────────────────
# Required only when YouTube sharing is enabled.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Backend server ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Required for scan caching, sessions and TikTok publishing.
# Leave empty to run without a database (scan results won't be cached).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DB_STATEMENT_TIMEOUT_MS=10000

# ── Database migrations ───────────────────────────────────────────────────────
# Required ONLY when running "npm run migrations:apply" from the server/ directory.
#
# Use the SESSION-MODE POOLER connection string, NOT the direct connection.
# The direct connection host is IPv6-only on Supabase — it has no IPv4 address
# and cannot be resolved on most networks.  The pooler hosts publish IPv4 and
# work reliably.
#
# Use the SESSION pooler (port 5432), not the transaction pooler (port 6543).
# The migration runner uses advisory locks and multi-statement transactions,
# neither of which survives transaction-pooler connection interruptions.
#
# Find the session-pooler URI in the Supabase dashboard under:
#   Project Settings → Database → Connection string → Session pooler
#
# The URI looks like:
#   postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# IMPORTANT — do NOT paste migration SQL directly into the Supabase SQL editor.
# The SQL editor executes statements but does not record them in the migration
# bookkeeping table.  The runner will then try to create already-existing objects
# and fail.  If you do paste SQL by mistake, the bookkeeping must be repaired by
# hand.  Always run migrations through the runner:
#   npm run migrations:apply   (from the server/ directory)
#
# After applying migrations, PostgREST reloads its schema cache automatically
# within ~5 seconds.  If queries against new tables return "relation not found"
# immediately after, wait a few seconds and retry.  The Supabase dashboard
# (Table Editor or SQL Editor refresh) also triggers a reload if needed.
DATABASE_URL=

# ── Secrets ───────────────────────────────────────────────────────────────────
# Required when the backend is running. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
ENCRYPTION_KEY=
COOKIE_SECURE=false

# ── Sessions ──────────────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=2592000
SESSION_IDLE_TTL_SECONDS=604800

# ── Auth0 (all three required together, or leave all empty) ───────────────────
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SCOPE=openid profile email

# ── ACRCloud (all three required together, or leave all empty) ────────────────
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
ACRCLOUD_TIMEOUT_MS=15000
ACRCLOUD_MAX_CONCURRENCY=8

# ── Identify cache ────────────────────────────────────────────────────────────
IDENTIFY_CACHE_TTL_SECONDS=604800
IDENTIFY_MAX_SAMPLE_BYTES=2097152

# ── TikTok (both required together, or leave both empty) ──────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4000/api/tiktok/callback
TIKTOK_TIMEOUT_MS=20000
TIKTOK_CHUNK_TIMEOUT_MS=120000

# ── Upload ────────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=536870912
PUBLISH_MAX_DURATION_MS=300000

# ── Background tasks ──────────────────────────────────────────────────────────
CLEANUP_INTERVAL_MS=900000

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── watsonx / Granite Vision (all five required together, or leave all empty) ──
# IBM watsonx.ai credentials for the visual copyright detection feature.
# Obtain at https://cloud.ibm.com/catalog/services/watson-machine-learning
# WATSONX_MODEL_ID defaults to ibm/granite-vision-3-2-2b, IBM's compact VLM.
# Leave all empty to run in heuristic-only mode (no IBM account required).
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-vision-3-2-2b
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_IAM_URL=https://iam.cloud.ibm.com
WATSONX_TIMEOUT_MS=30000
WATSONX_MAX_CONCURRENCY=4

# ── Visual identify cache ──────────────────────────────────────────────────────
VISUAL_IDENTIFY_CACHE_TTL_SECONDS=604800

{
  "name": "claimguard-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts | pino-pretty",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-test-coverage",
    "migrations:apply": "tsx --env-file=../.env scripts/apply-migrations.ts",
    "db:seed": "tsx --env-file=../.env scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/under-pressure": "^9.0.0",
    "@supabase/supabase-js": "^2.110.0",
    "fastify": "^5.2.0",
    "jose": "^5.9.0",
    "undici": "^7.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
